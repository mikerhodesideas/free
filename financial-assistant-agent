/**
 * Gera análise financeira completa usando Claude
 */
function gerarAnaliseCompleta() {
  Logger.log('--- Gerando análise financeira com IA ---');
  let ss = getSpreadsheet();

  let abaClass = ss.getSheetByName(ABA_CLASSIFICADOS);
  if (!abaClass) {
    Logger.log('Aba de classificados não encontrada. Execute a classificação primeiro.');
    return;
  }

  let dados = abaClass.getDataRange().getValues();
  if (dados.length <= 1) {
    Logger.log('Nenhum dado para analisar.');
    return;
  }

  // Prepara resumo dos dados para enviar ao Claude
  let resumoDados = prepararResumoDados(dados);

  let prompt = `Você é um consultor financeiro pessoal experiente analisando os dados financeiros de um cliente brasileiro.

DADOS FINANCEIROS:
${resumoDados}

Com base nesses dados, forneça uma análise financeira completa e estruturada em português brasileiro. Inclua:

1. **VISÃO GERAL**: Resumo da saúde financeira em 2-3 parágrafos.

2. **ANÁLISE DE RECEITAS**: De onde vem o dinheiro, estabilidade, tendências.

3. **ANÁLISE DE DESPESAS**:
   - Top 5 maiores categorias de gasto
   - Identificação de gastos recorrentes vs variáveis
   - Gastos que parecem acima da média

4. **TENDÊNCIAS**: Comparação mês a mês, padrões sazonais identificados.

5. **ALERTAS E RISCOS**:
   - Meses com saldo negativo
   - Categorias com crescimento preocupante
   - Dependência de fonte única de renda (se aplicável)

6. **RECOMENDAÇÕES**: 5 ações concretas e específicas para melhorar a situação financeira.

7. **SCORE DE SAÚDE FINANCEIRA**: Nota de 0 a 100 com justificativa.

Seja direto, use números reais dos dados, e dê conselhos práticos.`;

  let analise = callClaude(prompt, 4000);
  if (!analise) {
    Logger.log('Erro ao gerar análise.');
    return;
  }

  // Escreve na aba de análise
  let abaAnalise = getOrCreateSheet(ss, ABA_ANALISE, []);
  abaAnalise.clear();

  let linhas = analise.split('\n');
  let outputRows = [
    ['ANÁLISE FINANCEIRA - Gerada por IA em ' + new Date().toLocaleString('pt-BR')],
    ['']
  ];

  for (let linha of linhas) {
    outputRows.push([linha]);
  }

  abaAnalise.getRange(1, 1, outputRows.length, 1).setValues(outputRows);
  abaAnalise.getRange(1, 1).setFontSize(14).setFontWeight('bold');
  abaAnalise.setColumnWidth(1, 800);

  Logger.log('--- Análise financeira gerada com sucesso ---');
}

/**
 * Prepara um resumo estruturado dos dados para enviar ao Claude
 */
function prepararResumoDados(dados) {
  let resumoPorMes = {};
  let todasCategorias = {};
  let totalGeral = { receitas: 0, despesas: 0 };

  for (let i = 1; i < dados.length; i++) {
    let row = dados[i];
    let data = new Date(row[0]);
    if (isNaN(data.getTime())) continue;

    let mesAno = Utilities.formatDate(data, 'America/Sao_Paulo', 'yyyy-MM');
    let valor = Math.abs(parseFloat(row[2]) || 0);
    let tipo = String(row[3]).toLowerCase();
    let categoria = row[4] || 'Sem Categoria';

    if (!resumoPorMes[mesAno]) {
      resumoPorMes[mesAno] = { receitas: 0, despesas: 0, categorias: {} };
    }

    if (tipo === 'receita') {
      resumoPorMes[mesAno].receitas += valor;
      totalGeral.receitas += valor;
    } else {
      resumoPorMes[mesAno].despesas += valor;
      totalGeral.despesas += valor;
    }

    if (!resumoPorMes[mesAno].categorias[categoria]) {
      resumoPorMes[mesAno].categorias[categoria] = 0;
    }
    resumoPorMes[mesAno].categorias[categoria] += valor;

    todasCategorias[categoria] = (todasCategorias[categoria] || 0) + valor;
  }

  let texto = `PERÍODO: ${Object.keys(resumoPorMes).sort()[0]} a ${Object.keys(resumoPorMes).sort().pop()}\n`;
  texto += `TOTAL DE LANÇAMENTOS: ${dados.length - 1}\n`;
  texto += `TOTAL RECEITAS: R$ ${totalGeral.receitas.toFixed(2)}\n`;
  texto += `TOTAL DESPESAS: R$ ${totalGeral.despesas.toFixed(2)}\n`;
  texto += `SALDO: R$ ${(totalGeral.receitas - totalGeral.despesas).toFixed(2)}\n\n`;

  texto += 'RESUMO MENSAL:\n';
  let meses = Object.keys(resumoPorMes).sort();
  for (let mes of meses) {
    let r = resumoPorMes[mes];
    let saldo = r.receitas - r.despesas;
    texto += `  ${mes}: Receitas R$ ${r.receitas.toFixed(2)} | Despesas R$ ${r.despesas.toFixed(2)} | Saldo R$ ${saldo.toFixed(2)}\n`;

    let cats = Object.entries(r.categorias).sort((a, b) => b[1] - a[1]).slice(0, 5);
    for (let [cat, val] of cats) {
      texto += `    - ${cat}: R$ ${val.toFixed(2)}\n`;
    }
  }

  texto += '\nTOP CATEGORIAS (TOTAL):\n';
  let topCats = Object.entries(todasCategorias).sort((a, b) => b[1] - a[1]).slice(0, 10);
  for (let [cat, val] of topCats) {
    let pct = ((val / (totalGeral.receitas + totalGeral.despesas)) * 100).toFixed(1);
    texto += `  ${cat}: R$ ${val.toFixed(2)} (${pct}%)\n`;
  }

  return texto;
}


