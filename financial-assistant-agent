function gerarAnaliseCompleta(ss) {
  ss = ss || SpreadsheetApp.getActiveSpreadsheet();
  Logger.log('--- Gerando análise com IA ---');

  let abaClass = ss.getSheetByName(ABA_CLASSIFICADOS);
  if (!abaClass || abaClass.getLastRow() <= 1) {
    Logger.log('Nenhum dado para analisar.');
    return;
  }

  let dados = abaClass.getDataRange().getValues();
  let resumo = construirResumoParaIA(dados);

  let prompt = 'Você é um consultor financeiro pessoal analisando dados de um cliente brasileiro.\n\n' +
    'DADOS:\n' + resumo + '\n\n' +
    'Forneça em português brasileiro:\n\n' +
    '1. VISÃO GERAL (2-3 parágrafos sobre saúde financeira)\n\n' +
    '2. ANÁLISE DE RECEITAS (fontes, estabilidade, tendências)\n\n' +
    '3. ANÁLISE DE DESPESAS\n' +
    '   - Top 5 categorias de gasto com valores\n' +
    '   - Gastos recorrentes vs variáveis\n' +
    '   - Gastos acima da média\n\n' +
    '4. TENDÊNCIAS (evolução mês a mês, padrões)\n\n' +
    '5. ALERTAS E RISCOS\n' +
    '   - Meses com saldo negativo\n' +
    '   - Categorias com crescimento preocupante\n' +
    '   - Concentração de renda\n\n' +
    '6. RECOMENDAÇÕES (5 ações concretas e práticas)\n\n' +
    '7. SCORE DE SAÚDE FINANCEIRA (0-100 com justificativa)\n\n' +
    'Use números reais dos dados. Seja direto e prático.';

  let analise = callClaude(prompt, 4000);
  if (!analise) { Logger.log('Erro ao gerar análise.'); return; }

  let abaAnalise = getOrCreateSheet(ss, ABA_ANALISE, []);
  abaAnalise.clear();

  let linhas = analise.split('\n');
  let outputRows = [
    ['ANÁLISE FINANCEIRA - Gerada por IA em ' + Utilities.formatDate(new Date(), TIMEZONE, 'dd/MM/yyyy HH:mm')],
    ['']
  ];
  for (let linha of linhas) {
    outputRows.push([linha]);
  }

  abaAnalise.getRange(1, 1, outputRows.length, 1).setValues(outputRows);
  abaAnalise.getRange(1, 1).setFontSize(14).setFontWeight('bold');
  abaAnalise.setColumnWidth(1, 900);

  Logger.log('--- Análise gerada com sucesso ---');
}

/**
 * Constrói resumo numérico dos dados para enviar ao Claude
 */
function construirResumoParaIA(dados) {
  let porMes = {};
  let porCategoria = {};
  let total = { rec: 0, desp: 0 };
  let count = 0;

  for (let i = 1; i < dados.length; i++) {
    let data = new Date(dados[i][0]);
    if (isNaN(data.getTime())) continue;

    let mesAno = Utilities.formatDate(data, TIMEZONE, 'yyyy-MM');
    let valor = Math.abs(parseFloat(dados[i][2]) || 0);
    let tipo = String(dados[i][3] || '').toLowerCase().trim();
    let cat = String(dados[i][4] || 'Sem Categoria').trim();
    count++;

    if (!porMes[mesAno]) porMes[mesAno] = { rec: 0, desp: 0, cats: {} };

    if (tipo === 'receita') {
      porMes[mesAno].rec += valor;
      total.rec += valor;
    } else {
      porMes[mesAno].desp += valor;
      total.desp += valor;
    }

    porMes[mesAno].cats[cat] = (porMes[mesAno].cats[cat] || 0) + valor;
    porCategoria[cat] = (porCategoria[cat] || 0) + valor;
  }

  let meses = Object.keys(porMes).sort();
  let txt = 'Período: ' + (meses[0] || 'N/A') + ' a ' + (meses[meses.length - 1] || 'N/A') + '\n';
  txt += 'Total lançamentos: ' + count + '\n';
  txt += 'Total receitas: R$ ' + total.rec.toFixed(2) + '\n';
  txt += 'Total despesas: R$ ' + total.desp.toFixed(2) + '\n';
  txt += 'Saldo: R$ ' + (total.rec - total.desp).toFixed(2) + '\n\n';

  txt += 'POR MÊS:\n';
  for (let m of meses) {
    let r = porMes[m];
    txt += '  ' + m + ': Rec R$ ' + r.rec.toFixed(2) + ' | Desp R$ ' + r.desp.toFixed(2) + ' | Saldo R$ ' + (r.rec - r.desp).toFixed(2) + '\n';
    let topCats = Object.entries(r.cats).sort(function(a, b) { return b[1] - a[1]; }).slice(0, 5);
    for (let tc of topCats) {
      txt += '    - ' + tc[0] + ': R$ ' + tc[1].toFixed(2) + '\n';
    }
  }

  txt += '\nTOP CATEGORIAS:\n';
  let topGeral = Object.entries(porCategoria).sort(function(a, b) { return b[1] - a[1]; }).slice(0, 15);
  for (let tc of topGeral) {
    let pct = ((tc[1] / (total.rec + total.desp)) * 100).toFixed(1);
    txt += '  ' + tc[0] + ': R$ ' + tc[1].toFixed(2) + ' (' + pct + '%)\n';
  }

  return txt;
}


