/**
 * Lê lançamentos não classificados e usa Claude para classificá-los
 */
function classificarLancamentos() {
  Logger.log('--- Iniciando classificação de lançamentos ---');
  let ss = getSpreadsheet();

  let abaLanc = getOrCreateSheet(ss, ABA_LANCAMENTOS, ['Data', 'Descrição', 'Valor', 'Tipo', 'Categoria', 'Subcategoria', 'Observações']);
  let abaClass = getOrCreateSheet(ss, ABA_CLASSIFICADOS, ['Data', 'Descrição', 'Valor', 'Tipo', 'Categoria', 'Subcategoria', 'Confiança', 'Observações', 'Classificado Em']);

  let dados = abaLanc.getDataRange().getValues();
  if (dados.length <= 1) {
    Logger.log('Nenhum lançamento encontrado.');
    return;
  }

  let headers = dados[0];
  let colData = findColumn(headers, ['data', 'date']);
  let colDesc = findColumn(headers, ['descrição', 'descricao', 'description', 'desc']);
  let colValor = findColumn(headers, ['valor', 'value', 'amount', 'quantia']);
  let colTipo = findColumn(headers, ['tipo', 'type']);
  let colCategoria = findColumn(headers, ['categoria', 'category']);

  // Filtra lançamentos sem categoria
  let naoClassificados = [];
  let linhasOrigem = [];
  for (let i = 1; i < dados.length; i++) {
    let row = dados[i];
    if (row[colDesc] && (!row[colCategoria] || String(row[colCategoria]).trim() === '')) {
      naoClassificados.push({
        linha: i + 1,
        data: row[colData],
        descricao: row[colDesc],
        valor: row[colValor],
        tipo: row[colTipo] || ''
      });
      linhasOrigem.push(i + 1);
    }
  }

  if (naoClassificados.length === 0) {
    Logger.log('Todos os lançamentos já estão classificados.');
    return;
  }

  Logger.log(`Encontrados ${naoClassificados.length} lançamentos para classificar.`);

  // Carrega categorias customizadas (se existirem na aba Config)
  let categorias = carregarCategorias(ss);

  // Classifica em lotes de 20
  let batchSize = 20;
  for (let i = 0; i < naoClassificados.length; i += batchSize) {
    let batch = naoClassificados.slice(i, i + batchSize);
    let classificacoes = classificarComClaude(batch, categorias);

    if (!classificacoes || classificacoes.length === 0) {
      Logger.log(`Erro ao classificar lote ${Math.floor(i / batchSize) + 1}. Pulando.`);
      continue;
    }

    // Escreve classificações na aba original e na aba de classificados
    for (let j = 0; j < classificacoes.length; j++) {
      let c = classificacoes[j];
      let lancamento = batch[j];
      let linhaOrigem = linhasOrigem[i + j];

      // Atualiza a aba de lançamentos original
      if (colCategoria >= 0) {
        abaLanc.getRange(linhaOrigem, colCategoria + 1).setValue(c.categoria);
      }

      // Adiciona à aba de classificados
      abaClass.appendRow([
        lancamento.data,
        lancamento.descricao,
        lancamento.valor,
        c.tipo,
        c.categoria,
        c.subcategoria || '',
        c.confianca || 'alta',
        c.observacao || '',
        new Date()
      ]);
    }

    Logger.log(`Lote ${Math.floor(i / batchSize) + 1} classificado: ${classificacoes.length} itens.`);

    if (i + batchSize < naoClassificados.length) {
      Utilities.sleep(1000);
    }
  }

  Logger.log(`--- Classificação concluída: ${naoClassificados.length} lançamentos processados ---`);
}

/**
 * Envia lançamentos para Claude classificar
 */
function classificarComClaude(lancamentos, categorias) {
  let listaLancamentos = lancamentos.map((l, idx) =>
    `${idx + 1}. Data: ${l.data} | Descrição: "${l.descricao}" | Valor: R$ ${l.valor} | Tipo informado: ${l.tipo || 'não informado'}`
  ).join('\n');

  let listaCategorias = `
RECEITAS: ${categorias.receitas.join(', ')}
DESPESAS: ${categorias.despesas.join(', ')}`;

  let prompt = `Você é um assistente financeiro especializado em classificação de lançamentos bancários brasileiros.

Classifique cada lançamento abaixo em uma das categorias listadas. Retorne APENAS um JSON array, sem markdown, sem explicação.

CATEGORIAS DISPONÍVEIS:
${listaCategorias}

LANÇAMENTOS PARA CLASSIFICAR:
${listaLancamentos}

Retorne EXATAMENTE um JSON array onde cada item tem:
- "idx": número do lançamento (1-based)
- "tipo": "receita" ou "despesa"
- "categoria": uma das categorias listadas acima
- "subcategoria": detalhe mais específico se aplicável (ex: "Uber" para Transporte)
- "confianca": "alta", "media" ou "baixa"
- "observacao": breve justificativa da classificação

Responda APENAS com o JSON array. Nenhum texto adicional.`;

  let resposta = callClaude(prompt, 2000);
  if (!resposta) return null;

  try {
    // Limpa possíveis wrappers de markdown
    resposta = resposta.replace(/```json\n?/g, '').replace(/```\n?/g, '').trim();
    let classificacoes = JSON.parse(resposta);
    return classificacoes;
  } catch (e) {
    Logger.log('Erro ao parsear resposta do Claude: ' + e.message);
    Logger.log('Resposta recebida: ' + resposta.substring(0, 500));
    return null;
  }
}


