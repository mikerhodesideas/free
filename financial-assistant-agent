/**
 * Gera relatório mensal consolidado
 */
function gerarRelatorioMensal() {
  Logger.log('--- Gerando relatório mensal ---');
  let ss = getSpreadsheet();

  let abaClass = ss.getSheetByName(ABA_CLASSIFICADOS);
  if (!abaClass) {
    Logger.log('Aba de classificados não encontrada. Execute a classificação primeiro.');
    return;
  }

  let dados = abaClass.getDataRange().getValues();
  if (dados.length <= 1) {
    Logger.log('Nenhum dado classificado encontrado.');
    return;
  }

  // Agrupa por mês/ano e categoria
  let resumo = {};
  let headers = dados[0];

  for (let i = 1; i < dados.length; i++) {
    let row = dados[i];
    let data = new Date(row[0]);
    if (isNaN(data.getTime())) continue;

    let mesAno = Utilities.formatDate(data, 'America/Sao_Paulo', 'yyyy-MM');
    let mesAnoLabel = Utilities.formatDate(data, 'America/Sao_Paulo', 'MMMM yyyy');
    let valor = parseFloat(row[2]) || 0;
    let tipo = String(row[3]).toLowerCase();
    let categoria = row[4] || 'Sem Categoria';

    if (!resumo[mesAno]) {
      resumo[mesAno] = { label: mesAnoLabel, receitas: {}, despesas: {}, totalReceitas: 0, totalDespesas: 0 };
    }

    if (tipo === 'receita') {
      resumo[mesAno].receitas[categoria] = (resumo[mesAno].receitas[categoria] || 0) + Math.abs(valor);
      resumo[mesAno].totalReceitas += Math.abs(valor);
    } else {
      resumo[mesAno].despesas[categoria] = (resumo[mesAno].despesas[categoria] || 0) + Math.abs(valor);
      resumo[mesAno].totalDespesas += Math.abs(valor);
    }
  }

  // Escreve na aba de relatório
  let abaRel = getOrCreateSheet(ss, ABA_RELATORIO_MENSAL, []);
  abaRel.clear();

  let outputRows = [];
  outputRows.push(['RELATÓRIO FINANCEIRO MENSAL', '', '', '', 'Gerado em: ' + new Date().toLocaleString('pt-BR')]);
  outputRows.push(['']);

  let meses = Object.keys(resumo).sort();
  for (let mes of meses) {
    let r = resumo[mes];
    let saldo = r.totalReceitas - r.totalDespesas;

    outputRows.push(['📅 ' + r.label.toUpperCase(), '', '', '', '']);
    outputRows.push(['']);
    outputRows.push(['', 'RECEITAS', '', 'DESPESAS', '']);
    outputRows.push(['', 'Categoria', 'Valor (R$)', 'Categoria', 'Valor (R$)']);

    let receitasCats = Object.entries(r.receitas).sort((a, b) => b[1] - a[1]);
    let despesasCats = Object.entries(r.despesas).sort((a, b) => b[1] - a[1]);
    let maxRows = Math.max(receitasCats.length, despesasCats.length);

    for (let i = 0; i < maxRows; i++) {
      let recCat = receitasCats[i] ? receitasCats[i][0] : '';
      let recVal = receitasCats[i] ? receitasCats[i][1] : '';
      let despCat = despesasCats[i] ? despesasCats[i][0] : '';
      let despVal = despesasCats[i] ? despesasCats[i][1] : '';
      outputRows.push(['', recCat, recVal, despCat, despVal]);
    }

    outputRows.push(['']);
    outputRows.push(['', 'Total Receitas:', formatCurrency(r.totalReceitas), 'Total Despesas:', formatCurrency(r.totalDespesas)]);
    outputRows.push(['', 'SALDO DO MÊS:', formatCurrency(saldo), saldo >= 0 ? '✅ Positivo' : '⚠️ Negativo', '']);
    outputRows.push(['']);
    outputRows.push(['─────────────────────────────────────────────────────']);
    outputRows.push(['']);
  }

  // Resumo geral
  let totalGeralReceitas = meses.reduce((sum, m) => sum + resumo[m].totalReceitas, 0);
  let totalGeralDespesas = meses.reduce((sum, m) => sum + resumo[m].totalDespesas, 0);
  let saldoGeral = totalGeralReceitas - totalGeralDespesas;

  outputRows.push(['RESUMO GERAL']);
  outputRows.push(['Total de Receitas:', formatCurrency(totalGeralReceitas)]);
  outputRows.push(['Total de Despesas:', formatCurrency(totalGeralDespesas)]);
  outputRows.push(['Saldo Total:', formatCurrency(saldoGeral)]);
  outputRows.push(['Média Mensal de Receitas:', formatCurrency(totalGeralReceitas / meses.length)]);
  outputRows.push(['Média Mensal de Despesas:', formatCurrency(totalGeralDespesas / meses.length)]);
  outputRows.push(['Taxa de Poupança:', ((saldoGeral / totalGeralReceitas) * 100).toFixed(1) + '%']);

  if (outputRows.length > 0) {
    let maxCols = Math.max(...outputRows.map(r => Array.isArray(r) ? r.length : 1));
    let normalizedRows = outputRows.map(r => {
      let row = Array.isArray(r) ? r : [r];
      while (row.length < maxCols) row.push('');
      return row;
    });
    abaRel.getRange(1, 1, normalizedRows.length, maxCols).setValues(normalizedRows);
  }

  // Formatação
  abaRel.getRange(1, 1).setFontSize(14).setFontWeight('bold');
  abaRel.autoResizeColumns(1, 5);

  Logger.log('--- Relatório mensal gerado com sucesso ---');
}


