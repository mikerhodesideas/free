/**
 * Inicializa a planilha com a estrutura necessária
 */
function inicializarPlanilha() {
  let ss = getSpreadsheet();

  // Aba de lançamentos
  let abaLanc = getOrCreateSheet(ss, ABA_LANCAMENTOS, ['Data', 'Descrição', 'Valor', 'Tipo', 'Categoria', 'Subcategoria', 'Observações']);

  // Aba de classificados
  getOrCreateSheet(ss, ABA_CLASSIFICADOS, ['Data', 'Descrição', 'Valor', 'Tipo', 'Categoria', 'Subcategoria', 'Confiança', 'Observações', 'Classificado Em']);

  // Aba de relatório
  getOrCreateSheet(ss, ABA_RELATORIO_MENSAL, []);

  // Aba de análise
  getOrCreateSheet(ss, ABA_ANALISE, []);

  // Aba de configuração
  let abaConfig = getOrCreateSheet(ss, ABA_CONFIG, ['Configuração', 'Valor']);
  let configData = abaConfig.getDataRange().getValues();
  if (configData.length <= 1) {
    let configRows = [
      ['api_key', ''],
      ['model', CLAUDE_MODEL],
      ['categorias_receitas', CATEGORIAS_PADRAO.receitas.join(', ')],
      ['categorias_despesas', CATEGORIAS_PADRAO.despesas.join(', ')],
      ['timezone', 'America/Sao_Paulo'],
      ['moeda', 'BRL'],
      ['idioma', 'pt-BR']
    ];
    abaConfig.getRange(2, 1, configRows.length, 2).setValues(configRows);
  }

  // Formatação da aba de lançamentos
  abaLanc.setFrozenRows(1);
  abaLanc.getRange(1, 1, 1, 7).setFontWeight('bold').setBackground('#4a86c8').setFontColor('white');
  abaLanc.autoResizeColumns(1, 7);

  Logger.log('Planilha inicializada com sucesso.');
  try {
    SpreadsheetApp.getUi().alert('Planilha inicializada com sucesso!\n\nAbas criadas:\n- Lançamentos\n- Classificados\n- Relatório Mensal\n- Análise\n- Config\n\nInsira sua API Key na aba Config ou no código.');
  } catch (e) {
    // Se não tiver UI disponível (ex: rodando via trigger)
  }
}

/**
 * Carrega categorias customizadas da aba Config
 */
function carregarCategorias(ss) {
  let categorias = JSON.parse(JSON.stringify(CATEGORIAS_PADRAO));

  let abaConfig = ss.getSheetByName(ABA_CONFIG);
  if (!abaConfig) return categorias;

  let configData = abaConfig.getDataRange().getValues();
  for (let i = 1; i < configData.length; i++) {
    let chave = String(configData[i][0]).trim();
    let valor = String(configData[i][1]).trim();

    if (chave === 'categorias_receitas' && valor) {
      categorias.receitas = valor.split(',').map(s => s.trim()).filter(s => s);
    }
    if (chave === 'categorias_despesas' && valor) {
      categorias.despesas = valor.split(',').map(s => s.trim()).filter(s => s);
    }
  }

  return categorias;
}

/**
 * Abre popup para configurar categorias
 */
function abrirConfigCategorias() {
  let ss = getSpreadsheet();
  let abaConfig = getOrCreateSheet(ss, ABA_CONFIG, ['Configuração', 'Valor']);
  ss.setActiveSheet(abaConfig);
  SpreadsheetApp.getUi().alert(
    'Configure suas categorias na aba Config.\n\n' +
    'Edite as linhas "categorias_receitas" e "categorias_despesas" com suas categorias separadas por vírgula.'
  );
}


