/**
 * Obtém a planilha configurada
 */
function getSpreadsheet() {
  let id = SPREADSHEET_URL.match(/[-\w]{25,}/);
  if (!id) throw new Error('URL da planilha inválida. Verifique SPREADSHEET_URL.');
  return SpreadsheetApp.openById(id[0]);
}

/**
 * Obtém ou cria uma aba na planilha
 */
function getOrCreateSheet(ss, name, headers) {
  let sheet = ss.getSheetByName(name);
  if (!sheet) {
    sheet = ss.insertSheet(name);
    if (headers && headers.length > 0) {
      sheet.getRange(1, 1, 1, headers.length).setValues([headers]);
      sheet.setFrozenRows(1);
      sheet.getRange(1, 1, 1, headers.length).setFontWeight('bold');
    }
    Logger.log(`Aba "${name}" criada.`);
  }
  return sheet;
}

/**
 * Encontra o índice de uma coluna pelo nome (case-insensitive)
 */
function findColumn(headers, possibleNames) {
  for (let i = 0; i < headers.length; i++) {
    let h = String(headers[i]).toLowerCase().trim();
    for (let name of possibleNames) {
      if (h === name.toLowerCase()) return i;
    }
  }
  return -1;
}

/**
 * Formata valor como moeda brasileira
 */
function formatCurrency(value) {
  return 'R$ ' + parseFloat(value).toFixed(2).replace('.', ',').replace(/\B(?=(\d{3})+(?!\d))/g, '.');
}

/**
 * Chama a API do Claude (Anthropic)
 */
function callClaude(prompt, maxTokens) {
  let apiKey = getApiKey();
  if (!apiKey) {
    Logger.log('ERRO: API Key da Anthropic não configurada. Defina em ANTHROPIC_API_KEY ou na aba Config.');
    return null;
  }

  let url = 'https://api.anthropic.com/v1/messages';
  let payload = {
    'model': CLAUDE_MODEL,
    'max_tokens': maxTokens || 2000,
    'messages': [
      { 'role': 'user', 'content': prompt }
    ]
  };

  let options = {
    'method': 'POST',
    'muteHttpExceptions': true,
    'contentType': 'application/json',
    'headers': {
      'x-api-key': apiKey,
      'anthropic-version': '2023-06-01'
    },
    'payload': JSON.stringify(payload)
  };

  let response = UrlFetchApp.fetch(url, options);
  let rCode = response.getResponseCode();
  let rText = response.getContentText();

  if (rCode !== 200) {
    Logger.log(`Erro na API Anthropic (${rCode}): ${rText.substring(0, 300)}`);
    // Retry uma vez após 2 segundos
    Utilities.sleep(2000);
    response = UrlFetchApp.fetch(url, options);
    rCode = response.getResponseCode();
    rText = response.getContentText();

    if (rCode !== 200) {
      Logger.log(`Erro persistente na API (${rCode}).`);
      return null;
    }
  }

  let rJson = JSON.parse(rText);
  if (rJson && rJson.content && rJson.content.length > 0) {
    return rJson.content[0].text;
  }

  Logger.log('Resposta inesperada da API.');
  return null;
}

/**
 * Obtém a API Key (prioridade: aba Config > constante no código)
 */
function getApiKey() {
  // Tenta buscar da aba Config
  try {
    let ss = getSpreadsheet();
    let abaConfig = ss.getSheetByName(ABA_CONFIG);
    if (abaConfig) {
      let configData = abaConfig.getDataRange().getValues();
      for (let i = 1; i < configData.length; i++) {
        if (String(configData[i][0]).trim() === 'api_key') {
          let key = String(configData[i][1]).trim();
          if (key) return key;
        }
      }
    }
  } catch (e) {
    // Falha silenciosa, usa constante
  }

  return ANTHROPIC_API_KEY || null;
}
