/**
 * Configura trigger para executar automaticamente quando a planilha é editada
 * Classifica novos lançamentos a cada edição na aba de lançamentos
 */
function configurarTrigger() {
  // Remove triggers existentes deste projeto
  let triggers = ScriptApp.getProjectTriggers();
  for (let t of triggers) {
    if (t.getHandlerFunction() === 'onEditClassificar') {
      ScriptApp.deleteTrigger(t);
    }
  }

  // Cria trigger onChange (mais confiável que onEdit para mudanças via API)
  ScriptApp.newTrigger('onEditClassificar')
    .forSpreadsheet(SpreadsheetApp.getActiveSpreadsheet())
    .onChange()
    .create();

  // Cria trigger diário para relatório + análise
  let existing = ScriptApp.getProjectTriggers().filter(function(t) {
    return t.getHandlerFunction() === 'gerarRelatorioEAnalise';
  });
  if (existing.length === 0) {
    ScriptApp.newTrigger('gerarRelatorioEAnalise')
      .timeBased()
      .everyDays(1)
      .atHour(6)
      .create();
  }

  try {
    SpreadsheetApp.getUi().alert(
      'Triggers configurados!\n\n' +
      '1. Classificação automática: executa quando a planilha é editada\n' +
      '2. Relatório + Análise: executa diariamente às 6h'
    );
  } catch(e) {}

  Logger.log('Triggers configurados.');
}

/**
 * Handler do trigger onChange - classifica novos lançamentos
 */
function onEditClassificar() {
  try {
    let ss = SpreadsheetApp.getActiveSpreadsheet();
    let detecao = detectarAbaLancamentos(ss);
    if (detecao) {
      classificarLancamentos(ss, detecao);
    }
  } catch (e) {
    Logger.log('Erro no trigger: ' + e.message);
  }
}

/**
 * Handler do trigger diário - gera relatório e análise
 */
function gerarRelatorioEAnalise() {
  let ss = SpreadsheetApp.getActiveSpreadsheet();
  gerarRelatorioMensal(ss);
  gerarAnaliseCompleta(ss);
}


