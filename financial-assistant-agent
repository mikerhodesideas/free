/**
 * Escaneia todas as abas da planilha e encontra a que tem lançamentos financeiros.
 * Retorna objeto com sheet, headers, índices de colunas e dados.
 */
function detectarAbaLancamentos(ss) {
  let sheets = ss.getSheets();
  let melhorMatch = null;
  let melhorScore = 0;

  // Nomes de abas criadas pelo agente - pular
  let abasIgnorar = [ABA_CLASSIFICADOS, ABA_RELATORIO, ABA_ANALISE, 'Config'];

  for (let sheet of sheets) {
    let nome = sheet.getName();
    if (abasIgnorar.indexOf(nome) >= 0) continue;

    let dados = sheet.getDataRange().getValues();
    if (dados.length < 2) continue; // precisa de header + pelo menos 1 linha

    let headers = dados[0].map(h => String(h).toLowerCase().trim());
    let score = 0;
    let colData = -1, colDesc = -1, colValor = -1, colTipo = -1, colCategoria = -1;

    // Detecta coluna de Data
    colData = matchColumn(headers, ['data', 'date', 'dt', 'dia', 'data lancamento', 'data lançamento', 'data_lancamento']);
    if (colData >= 0) score += 3;

    // Detecta coluna de Descrição
    colDesc = matchColumn(headers, ['descrição', 'descricao', 'description', 'desc', 'historico', 'histórico',
      'memo', 'detalhes', 'detalhe', 'lancamento', 'lançamento', 'nome', 'referencia', 'referência']);
    if (colDesc >= 0) score += 3;

    // Detecta coluna de Valor
    colValor = matchColumn(headers, ['valor', 'value', 'amount', 'quantia', 'montante', 'total',
      'valor (r$)', 'valor r$', 'vlr', 'val']);
    if (colValor >= 0) score += 3;

    // Detecta coluna de Tipo (opcional)
    colTipo = matchColumn(headers, ['tipo', 'type', 'natureza', 'entrada/saída', 'entrada/saida',
      'credito/debito', 'crédito/débito', 'c/d', 'd/c']);
    if (colTipo >= 0) score += 1;

    // Detecta coluna de Categoria (opcional)
    colCategoria = matchColumn(headers, ['categoria', 'category', 'classificação', 'classificacao', 'class', 'grupo']);
    if (colCategoria >= 0) score += 1;

    // Bonus por nome da aba
    let nomeL = nome.toLowerCase();
    if (nomeL.match(/lanç|lanc|extrato|transaç|transac|moviment|financ|fluxo|caixa|contas/)) {
      score += 2;
    }

    // Valida se tem dados numéricos na coluna de valor
    if (colValor >= 0 && dados.length > 1) {
      let temNumero = false;
      for (let i = 1; i < Math.min(dados.length, 10); i++) {
        let v = dados[i][colValor];
        if (typeof v === 'number' || (typeof v === 'string' && v.match(/[\d.,]+/))) {
          temNumero = true;
          break;
        }
      }
      if (temNumero) score += 2;
    }

    // Precisa ter no mínimo data + descrição + valor
    if (colData >= 0 && colDesc >= 0 && colValor >= 0 && score > melhorScore) {
      melhorScore = score;
      melhorMatch = {
        sheet: sheet,
        dados: dados,
        headers: dados[0],
        headersLower: headers,
        colData: colData,
        colDesc: colDesc,
        colValor: colValor,
        colTipo: colTipo,
        colCategoria: colCategoria,
        numRows: dados.length - 1
      };
    }
  }

  // Se não encontrou com match exato, tenta match fuzzy nos headers
  if (!melhorMatch) {
    melhorMatch = detectarPorConteudo(sheets, abasIgnorar);
  }

  return melhorMatch;
}

/**
 * Fallback: detecta por conteúdo (procura colunas com datas e números)
 */
function detectarPorConteudo(sheets, abasIgnorar) {
  for (let sheet of sheets) {
    if (abasIgnorar.indexOf(sheet.getName()) >= 0) continue;

    let dados = sheet.getDataRange().getValues();
    if (dados.length < 3) continue;

    let numCols = dados[0].length;
    let colData = -1, colDesc = -1, colValor = -1;

    for (let c = 0; c < numCols; c++) {
      let dateCount = 0, numCount = 0, textCount = 0;

      for (let r = 1; r < Math.min(dados.length, 15); r++) {
        let val = dados[r][c];
        if (val instanceof Date || (typeof val === 'string' && val.match(/^\d{1,2}[\/-]\d{1,2}[\/-]\d{2,4}$/))) {
          dateCount++;
        } else if (typeof val === 'number') {
          numCount++;
        } else if (typeof val === 'string' && val.length > 3) {
          textCount++;
        }
      }

      let sampleSize = Math.min(dados.length - 1, 14);
      if (dateCount > sampleSize * 0.5 && colData < 0) colData = c;
      else if (numCount > sampleSize * 0.5 && colValor < 0) colValor = c;
      else if (textCount > sampleSize * 0.5 && colDesc < 0) colDesc = c;
    }

    if (colData >= 0 && colDesc >= 0 && colValor >= 0) {
      return {
        sheet: sheet,
        dados: dados,
        headers: dados[0],
        headersLower: dados[0].map(h => String(h).toLowerCase().trim()),
        colData: colData,
        colDesc: colDesc,
        colValor: colValor,
        colTipo: -1,
        colCategoria: -1,
        numRows: dados.length - 1
      };
    }
  }
  return null;
}

/**
 * Match flexível de coluna
 */
function matchColumn(headers, candidates) {
  // Match exato
  for (let i = 0; i < headers.length; i++) {
    for (let c of candidates) {
      if (headers[i] === c) return i;
    }
  }
  // Match parcial (contém)
  for (let i = 0; i < headers.length; i++) {
    for (let c of candidates) {
      if (headers[i].indexOf(c) >= 0 || c.indexOf(headers[i]) >= 0) return i;
    }
  }
  return -1;
}


// ===========================================================================================================
// CLASSIFICAÇÃO DE LANÇAMENTOS
// ===========================================================================================================

function classificarLancamentos(ss, detecao) {
  ss = ss || SpreadsheetApp.getActiveSpreadsheet();
  detecao = detecao || detectarAbaLancamentos(ss);
  if (!detecao) { Logger.log('Nenhuma aba de lançamentos encontrada.'); return; }

  Logger.log('--- Classificando lançamentos ---');
  let abaLanc = detecao.sheet;
  let dados = detecao.dados;

  // Garante que existe coluna de Categoria na aba original
  let colCategoria = detecao.colCategoria;
  if (colCategoria < 0) {
    // Adiciona coluna "Categoria" ao final dos headers
    colCategoria = detecao.headers.length;
    abaLanc.getRange(1, colCategoria + 1).setValue('Categoria');
    detecao.colCategoria = colCategoria;
  }

  // Adiciona coluna de Tipo se não existir
  let colTipo = detecao.colTipo;
  if (colTipo < 0) {
    colTipo = colCategoria + 1;
    if (!detecao.headers[colTipo]) {
      abaLanc.getRange(1, colTipo + 1).setValue('Tipo');
      detecao.colTipo = colTipo;
    }
  }

  // Cria aba de classificados
  let abaClass = getOrCreateSheet(ss, ABA_CLASSIFICADOS,
    ['Data', 'Descrição', 'Valor', 'Tipo', 'Categoria', 'Subcategoria', 'Confiança', 'Observação', 'Classificado Em']);

  // Coleta lançamentos não classificados
  let naoClassificados = [];
  let linhasOrigem = [];
  for (let i = 1; i < dados.length; i++) {
    let row = dados[i];
    let desc = row[detecao.colDesc];
    let categoriaAtual = colCategoria < row.length ? row[colCategoria] : '';

    if (desc && String(desc).trim() && (!categoriaAtual || String(categoriaAtual).trim() === '')) {
      naoClassificados.push({
        idx: i,
        data: formatarData(row[detecao.colData]),
        descricao: String(desc).trim(),
        valor: parseValor(row[detecao.colValor]),
        tipo: detecao.colTipo >= 0 && detecao.colTipo < row.length ? String(row[detecao.colTipo]).trim() : ''
      });
      linhasOrigem.push(i + 1); // 1-based para getRange
    }
  }

  if (naoClassificados.length === 0) {
    Logger.log('Todos os lançamentos já estão classificados.');
    return;
  }

  Logger.log('Lançamentos para classificar: ' + naoClassificados.length);

  // Classifica em lotes de 25
  let batchSize = 25;
  let totalClassificados = 0;

  for (let i = 0; i < naoClassificados.length; i += batchSize) {
    let batch = naoClassificados.slice(i, i + batchSize);
    let result = classificarBatchComClaude(batch);

    if (!result) {
      Logger.log('Erro no lote ' + (Math.floor(i / batchSize) + 1) + '. Continuando...');
      continue;
    }

    for (let j = 0; j < batch.length; j++) {
      let c = result[j] || { tipo: 'despesa', categoria: 'Outras Despesas', subcategoria: '', confianca: 'baixa', observacao: 'Classificação automática falhou' };
      let lancamento = batch[j];
      let linhaOrigem = linhasOrigem[i + j];

      // Atualiza aba original
      abaLanc.getRange(linhaOrigem, colCategoria + 1).setValue(c.categoria);
      if (detecao.colTipo >= 0) {
        abaLanc.getRange(linhaOrigem, detecao.colTipo + 1).setValue(c.tipo);
      }

      // Adiciona à aba classificados
      abaClass.appendRow([
        lancamento.data,
        lancamento.descricao,
        lancamento.valor,
        c.tipo || 'despesa',
        c.categoria || 'Outras Despesas',
        c.subcategoria || '',
        c.confianca || 'media',
        c.observacao || '',
        new Date()
      ]);

      totalClassificados++;
    }

    Logger.log('Lote ' + (Math.floor(i / batchSize) + 1) + ' OK: ' + batch.length + ' itens');
    if (i + batchSize < naoClassificados.length) Utilities.sleep(1500);
  }

  Logger.log('--- Classificação concluída: ' + totalClassificados + ' lançamentos ---');
}

/**
 * Classifica um batch de lançamentos via Claude
 */
function classificarBatchComClaude(batch) {
  let lista = batch.map(function(l, idx) {
    return (idx + 1) + '. Data: ' + l.data + ' | Descrição: "' + l.descricao + '" | Valor: R$ ' + l.valor + ' | Tipo: ' + (l.tipo || 'n/a');
  }).join('\n');

  let prompt = 'Você é um assistente financeiro expert em classificar lançamentos bancários brasileiros.\n\n' +
    'CATEGORIAS DISPONÍVEIS:\n' +
    'RECEITAS: ' + CATEGORIAS.receitas.join(', ') + '\n' +
    'DESPESAS: ' + CATEGORIAS.despesas.join(', ') + '\n\n' +
    'LANÇAMENTOS:\n' + lista + '\n\n' +
    'Retorne APENAS um JSON array (sem markdown, sem ```). Cada item:\n' +
    '{"idx":1,"tipo":"receita|despesa","categoria":"...","subcategoria":"...","confianca":"alta|media|baixa","observacao":"..."}\n\n' +
    'REGRAS:\n' +
    '- Valores positivos geralmente são receitas, negativos são despesas\n' +
    '- PIX, TED, DOC podem ser receita ou despesa - analise o contexto da descrição\n' +
    '- "Salário", "pagto salario" = Salário (receita)\n' +
    '- Supermercado, restaurante, iFood, Rappi = Alimentação\n' +
    '- Uber, 99, combustível, estacionamento = Transporte\n' +
    '- Netflix, Spotify, Amazon Prime = Assinaturas/Serviços\n' +
    '- Se não tiver certeza, use confianca "baixa"\n\n' +
    'JSON array:';

  let resposta = callClaude(prompt, 3000);
  if (!resposta) return null;

  try {
    resposta = resposta.replace(/```json\n?/g, '').replace(/```\n?/g, '').trim();
    // Tenta encontrar o array JSON na resposta
    let match = resposta.match(/\[[\s\S]*\]/);
    if (match) resposta = match[0];
    return JSON.parse(resposta);
  } catch (e) {
    Logger.log('Erro ao parsear JSON: ' + e.message);
    Logger.log('Resposta: ' + resposta.substring(0, 300));
    return null;
  }
}


// ===========================================================================================================
// RELATÓRIO MENSAL
// ===========================================================================================================

function gerarRelatorioMensal(ss) {
  ss = ss || SpreadsheetApp.getActiveSpreadsheet();
  Logger.log('--- Gerando relatório mensal ---');

  let abaClass = ss.getSheetByName(ABA_CLASSIFICADOS);
  if (!abaClass || abaClass.getLastRow() <= 1) {
    Logger.log('Nenhum dado classificado. Execute a classificação primeiro.');
    return;
  }

  let dados = abaClass.getDataRange().getValues();
  let resumo = {};

  for (let i = 1; i < dados.length; i++) {
    let row = dados[i];
    let data = new Date(row[0]);
    if (isNaN(data.getTime())) continue;

    let mesAno = Utilities.formatDate(data, TIMEZONE, 'yyyy-MM');
    let mesLabel = Utilities.formatDate(data, TIMEZONE, 'MM/yyyy');
    let valor = Math.abs(parseFloat(row[2]) || 0);
    let tipo = String(row[3]).toLowerCase().trim();
    let categoria = String(row[4] || 'Sem Categoria').trim();

    if (!resumo[mesAno]) {
      resumo[mesAno] = { label: mesLabel, receitas: {}, despesas: {}, totalRec: 0, totalDesp: 0 };
    }

    if (tipo === 'receita') {
      resumo[mesAno].receitas[categoria] = (resumo[mesAno].receitas[categoria] || 0) + valor;
      resumo[mesAno].totalRec += valor;
    } else {
      resumo[mesAno].despesas[categoria] = (resumo[mesAno].despesas[categoria] || 0) + valor;
      resumo[mesAno].totalDesp += valor;
    }
  }

  // Monta o relatório
  let abaRel = getOrCreateSheet(ss, ABA_RELATORIO, []);
  abaRel.clear();

  let rows = [];
  let meses = Object.keys(resumo).sort();

  // Header
  rows.push(['RELATÓRIO FINANCEIRO MENSAL', '', '', '', '', 'Gerado: ' + Utilities.formatDate(new Date(), TIMEZONE, 'dd/MM/yyyy HH:mm')]);
  rows.push(['', '', '', '', '', '']);

  // Tabela resumo geral
  rows.push(['Mês', 'Receitas (R$)', 'Despesas (R$)', 'Saldo (R$)', '% Poupança', 'Status']);

  let totalRec = 0, totalDesp = 0;

  for (let mes of meses) {
    let r = resumo[mes];
    let saldo = r.totalRec - r.totalDesp;
    let poupanca = r.totalRec > 0 ? ((saldo / r.totalRec) * 100).toFixed(1) + '%' : '0%';
    totalRec += r.totalRec;
    totalDesp += r.totalDesp;

    rows.push([
      r.label,
      r.totalRec.toFixed(2),
      r.totalDesp.toFixed(2),
      saldo.toFixed(2),
      poupanca,
      saldo >= 0 ? 'Positivo' : 'Negativo'
    ]);
  }

  let saldoTotal = totalRec - totalDesp;
  rows.push([
    'TOTAL',
    totalRec.toFixed(2),
    totalDesp.toFixed(2),
    saldoTotal.toFixed(2),
    totalRec > 0 ? ((saldoTotal / totalRec) * 100).toFixed(1) + '%' : '0%',
    saldoTotal >= 0 ? 'Positivo' : 'Negativo'
  ]);

  rows.push(['', '', '', '', '', '']);
  rows.push(['', '', '', '', '', '']);

  // Detalhamento por mês
  for (let mes of meses) {
    let r = resumo[mes];
    rows.push(['DETALHE - ' + r.label, '', '', '', '', '']);
    rows.push(['Categoria', 'Tipo', 'Valor (R$)', '% do Total', '', '']);

    let allCats = [];
    for (let cat in r.receitas) {
      allCats.push({ cat: cat, tipo: 'Receita', valor: r.receitas[cat] });
    }
    for (let cat in r.despesas) {
      allCats.push({ cat: cat, tipo: 'Despesa', valor: r.despesas[cat] });
    }
    allCats.sort(function(a, b) { return b.valor - a.valor; });

    let totalMes = r.totalRec + r.totalDesp;
    for (let item of allCats) {
      let pct = totalMes > 0 ? ((item.valor / totalMes) * 100).toFixed(1) + '%' : '0%';
      rows.push([item.cat, item.tipo, item.valor.toFixed(2), pct, '', '']);
    }

    rows.push(['', '', '', '', '', '']);
  }

  // Escreve tudo
  if (rows.length > 0) {
    let maxCols = 6;
    let normalized = rows.map(function(r) {
      while (r.length < maxCols) r.push('');
      return r.slice(0, maxCols);
    });
    abaRel.getRange(1, 1, normalized.length, maxCols).setValues(normalized);
  }

  // Formatação
  abaRel.getRange(1, 1).setFontSize(14).setFontWeight('bold');
  abaRel.getRange(3, 1, 1, 6).setFontWeight('bold').setBackground('#4a86c8').setFontColor('white');
  abaRel.autoResizeColumns(1, 6);

  // Formatação de números como moeda
  let lastRow = abaRel.getLastRow();
  if (lastRow > 3) {
    abaRel.getRange(4, 2, lastRow - 3, 3).setNumberFormat('#,##0.00');
  }

  Logger.log('--- Relatório gerado: ' + meses.length + ' meses ---');
}


